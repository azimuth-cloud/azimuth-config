#!/usr/bin/env python3

"""Collect a safe read-only inventory from the OpenStack CI project."""

from __future__ import annotations

import argparse
import csv
import json
import logging
import os
import re
import stat
import sys
from collections import Counter
from collections.abc import Callable, Iterable, Mapping
from dataclasses import asdict, dataclass, field
from datetime import datetime, timezone
from enum import IntEnum
from pathlib import Path
from typing import Any

import openstack
from keystoneauth1 import exceptions as ks_exceptions
from openstack import exceptions

OPENSTACK_EXCEPTIONS = (exceptions.SDKException, ks_exceptions.ClientException)
SAFE_IDENTIFIER_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")
INVENTORY_SCHEMA_VERSION = 1
OCTAVIA_DEVICE_OWNER = "Octavia"
OCTAVIA_LOAD_BALANCER_PREFIX = "lb-"
RELATIONSHIP_TYPES = (
    "load_balancer_ids",
    "network_ids",
    "pool_ids",
    "port_ids",
    "router_ids",
    "security_group_ids",
    "server_ids",
    "subnet_ids",
    "volume_ids",
)
LOGGER = logging.getLogger(__name__)


class ConfigurationError(RuntimeError):
    """Raised when inventory cannot safely run with the supplied scope."""


class ExitCode(IntEnum):
    SUCCESS = 0
    FATAL_ERROR = 1
    PARTIAL_INVENTORY = 2


@dataclass(frozen=True)
class CollectionError:
    collection: str
    resource_id: str
    error_code: str


@dataclass(frozen=True)
class InventoryRecord:
    resource_type: str
    resource_id: str
    name: str = ""
    status: str = ""
    secondary_status: str = ""
    created_at: str = ""
    updated_at: str = ""
    project_id: str = ""
    device_owner: str = ""
    key_name: str = ""
    relationships: dict[str, list[str]] = field(default_factory=dict)


def get_field(resource: object, name: str, default: Any = None) -> Any:
    if isinstance(resource, Mapping):
        return resource.get(name, default)
    return getattr(resource, name, default)


def safe_identifier(value: object) -> str:
    text = str(value or "")
    return text if SAFE_IDENTIFIER_RE.fullmatch(text) else ""


def safe_text(value: object, *, limit: int = 160) -> str:
    if isinstance(value, datetime):
        value = value.isoformat(timespec="seconds")
    text = str(value or "")
    if not text or len(text) > limit or not text.isascii() or not text.isprintable():
        return ""
    if text[0] in "=+-@":
        return ""
    return text


SOURCE_FIELD_SPECS: dict[str, tuple[str, Callable[[object], str]]] = {
    "cloud": ("OS_CLOUD", safe_text),
    "github_event_name": ("GITHUB_EVENT_NAME", safe_text),
    "github_run_attempt": ("GITHUB_RUN_ATTEMPT", safe_identifier),
    "github_run_id": ("GITHUB_RUN_ID", safe_identifier),
    "github_sha": ("GITHUB_SHA", safe_identifier),
}
SOURCE_FIELDS = tuple(SOURCE_FIELD_SPECS)


def error_code(exc: BaseException) -> str:
    if isinstance(exc, exceptions.ResourceNotFound):
        return "not_found"
    if isinstance(exc, exceptions.ResourceTimeout):
        return "timeout"
    if isinstance(exc, exceptions.HttpException):
        status_code = getattr(exc, "status_code", None)
        if status_code:
            return f"http_{status_code}"
    return safe_identifier(type(exc).__name__) or "unknown_error"


def related_ids(*values: object) -> list[str]:
    identifiers = set()
    for value in values:
        if isinstance(value, Iterable) and not isinstance(value, (str, bytes, Mapping)):
            identifiers.update(related_ids(*value))
            continue
        if isinstance(value, Mapping) or not isinstance(value, (str, bytes)):
            value = get_field(value, "id", get_field(value, "resource_id", ""))
        identifier = safe_identifier(value)
        if identifier:
            identifiers.add(identifier)
    return sorted(identifiers)


def append_step_summary(markdown: str) -> None:
    summary_path = os.environ.get("GITHUB_STEP_SUMMARY")
    if not summary_path:
        return
    try:
        with Path(summary_path).open("a", encoding="utf-8") as summary_file:
            summary_file.write(markdown)
    except OSError:
        LOGGER.warning("Could not write the GitHub Actions step summary")


def source_context() -> dict[str, str]:
    return {
        field_name: sanitizer(os.environ.get(environment_name))
        for field_name, (environment_name, sanitizer) in SOURCE_FIELD_SPECS.items()
    }


# this collector is read-only and only converts allowlisted fields to records
class InventoryCollector:
    def __init__(self, connection: object, *, expected_project_id: str, project_name: str) -> None:
        self.connection = connection
        self.expected_project_id = expected_project_id
        self.project_name = project_name
        self.project_id = ""
        self.records: list[InventoryRecord] = []
        self.errors: list[CollectionError] = []

    def validate_project(self) -> None:
        try:
            project_id = safe_identifier(self.connection.current_project_id)
        except OPENSTACK_EXCEPTIONS as exc:
            raise ConfigurationError(f"could not determine scoped project ({error_code(exc)})") from exc
        if not project_id:
            raise ConfigurationError("the OpenStack credential is not project-scoped")
        if project_id != self.expected_project_id:
            raise ConfigurationError("the credential is scoped to a different OpenStack project")
        self.project_id = project_id
        LOGGER.info("Collecting inventory for project %s (%s)", project_id, self.project_name)

    def record_error(self, collection: str, exc_or_code: BaseException | str, resource_id: object = "") -> None:
        code = error_code(exc_or_code) if isinstance(exc_or_code, BaseException) else safe_identifier(exc_or_code)
        record = CollectionError(
            collection=safe_identifier(collection) or "unknown",
            resource_id=safe_identifier(resource_id),
            error_code=code or "unknown_error",
        )
        self.errors.append(record)
        LOGGER.error("%s inventory failed (%s)", record.collection, record.error_code)

    # reject any untarget project result even if a cloud unexpectedly returns one.
    def add_record(self, record: InventoryRecord) -> None:
        if record.project_id and record.project_id != self.expected_project_id:
            self.record_error(record.resource_type, "project_mismatch", record.resource_id)
            return
        self.records.append(record)

    def collect_list(
        self,
        collection: str,
        resources: Callable[[], Iterable[object]],
        convert: Callable[[object], InventoryRecord],
    ) -> list[object]:
        collected = []
        try:
            for resource in resources():
                collected.append(resource)
                try:
                    self.add_record(convert(resource))
                except (AttributeError, TypeError, ValueError) as exc:
                    self.record_error(collection, exc, get_field(resource, "id"))
        except OPENSTACK_EXCEPTIONS as exc:
            self.record_error(collection, exc)
        except (AttributeError, TypeError, ValueError) as exc:
            self.record_error(collection, exc)
        return collected

    # build common fields once so every resource snapshot has the same safe shape.
    def make_record(
        self,
        resource_type: str,
        resource: object,
        *,
        resource_id: object = "",
        relationships: Mapping[str, list[str]] | None = None,
        device_owner: object = "",
        key_name: object = "",
    ) -> InventoryRecord:
        identifier = safe_identifier(resource_id or get_field(resource, "id"))
        if not identifier:
            raise ValueError(f"{resource_type} has no safe id")
        project_id = safe_identifier(get_field(resource, "project_id") or get_field(resource, "tenant_id"))
        status = get_field(resource, "status") or get_field(resource, "provisioning_status")
        secondary_status = get_field(resource, "operating_status")
        return InventoryRecord(
            resource_type=resource_type,
            resource_id=identifier,
            name=safe_text(get_field(resource, "name")),
            status=safe_text(status),
            secondary_status=safe_text(secondary_status),
            created_at=safe_text(get_field(resource, "created_at") or get_field(resource, "created")),
            updated_at=safe_text(get_field(resource, "updated_at") or get_field(resource, "updated")),
            project_id=project_id,
            device_owner=safe_text(device_owner),
            key_name=safe_text(key_name),
            relationships={key: sorted(set(values)) for key, values in (relationships or {}).items() if values},
        )

    # record server state and key name but not include metadata, addresses, or user data.
    def server_record(self, server: object) -> InventoryRecord:
        return self.make_record(
            "server",
            server,
            key_name=get_field(server, "key_name"),
            relationships={"volume_ids": related_ids(get_field(server, "attached_volumes", []))},
        )

    # compare the basic server list with detail lookups
    # so nova ghost(unhealthy backend) stay visible
    def collect_servers(self) -> None:
        try:
            listed_servers = self.connection.compute.servers(details=False)
            for listed_server in listed_servers:
                server_id = safe_identifier(get_field(listed_server, "id"))
                if not server_id:
                    self.record_error("server", "missing_id")
                    continue
                try:
                    server = self.connection.compute.get_server(server_id)
                except exceptions.ResourceNotFound:
                    server = None
                except OPENSTACK_EXCEPTIONS as exc:
                    self.record_error("server_detail", exc, server_id)
                    continue

                try:
                    if server is None:
                        self.add_record(self.make_record("server_detail_missing", listed_server))
                        LOGGER.warning(
                            "Server %s (%s) was returned by list but is missing from the detail API",
                            safe_text(get_field(listed_server, "name")) or "unknown",
                            server_id,
                        )
                    else:
                        self.add_record(self.server_record(server))
                except (AttributeError, TypeError, ValueError) as exc:
                    self.record_error("server", exc, server_id)
        except OPENSTACK_EXCEPTIONS as exc:
            self.record_error("server", exc)
        except (AttributeError, TypeError, ValueError) as exc:
            self.record_error("server", exc)

    # keep volume attachments because they explain why cinder can block deletion.
    def volume_record(self, volume: object) -> InventoryRecord:
        attachments = get_field(volume, "attachments", []) or []
        return self.make_record(
            "volume",
            volume,
            relationships={"server_ids": related_ids(*(get_field(item, "server_id") for item in attachments))},
        )

    # connect snapshots and backups to their parent volume for cleanup ordering.
    def volume_child_record(self, resource_type: str, resource: object) -> InventoryRecord:
        return self.make_record(
            resource_type,
            resource,
            relationships={"volume_ids": related_ids(get_field(resource, "volume_id"))},
        )

    def port_record(self, port: object) -> InventoryRecord:
        owner = safe_text(get_field(port, "device_owner"))
        resource_type = "router_interface" if owner.startswith("network:router_interface") else "port"
        fixed_ips = get_field(port, "fixed_ips", []) or []
        relationships = {
            "network_ids": related_ids(get_field(port, "network_id")),
            "security_group_ids": related_ids(
                get_field(port, "security_group_ids") or get_field(port, "security_groups", [])
            ),
            "subnet_ids": related_ids(*(get_field(item, "subnet_id") for item in fixed_ips)),
        }
        device_id = str(get_field(port, "device_id") or "")
        if owner.startswith("network:router"):
            relationships["router_ids"] = related_ids(device_id)
        elif owner.startswith("compute:"):
            relationships["server_ids"] = related_ids(device_id)
        elif owner == OCTAVIA_DEVICE_OWNER and device_id.startswith(OCTAVIA_LOAD_BALANCER_PREFIX):
            load_balancer_id = device_id.removeprefix(OCTAVIA_LOAD_BALANCER_PREFIX)
            relationships["load_balancer_ids"] = related_ids(load_balancer_id)
        return self.make_record(resource_type, port, relationships=relationships, device_owner=owner)

    def subnet_record(self, subnet: object) -> InventoryRecord:
        return self.make_record(
            "subnet", subnet, relationships={"network_ids": related_ids(get_field(subnet, "network_id"))}
        )

    def router_record(self, router: object) -> InventoryRecord:
        gateway = get_field(router, "external_gateway_info", {}) or {}
        return self.make_record(
            "router", router, relationships={"network_ids": related_ids(get_field(gateway, "network_id"))}
        )

    # connect floating ips to ports, routers, and their external network.
    def floating_ip_record(self, floating_ip: object) -> InventoryRecord:
        return self.make_record(
            "floating_ip",
            floating_ip,
            relationships={
                "network_ids": related_ids(get_field(floating_ip, "floating_network_id")),
                "port_ids": related_ids(get_field(floating_ip, "port_id")),
                "router_ids": related_ids(get_field(floating_ip, "router_id")),
            },
        )

    def keypair_record(self, keypair: object) -> InventoryRecord:
        name = safe_text(get_field(keypair, "name"))
        return self.make_record("keypair", keypair, resource_id=name)

    def load_balancer_record(self, load_balancer: object) -> InventoryRecord:
        return self.make_record(
            "load_balancer",
            load_balancer,
            relationships={
                "network_ids": related_ids(get_field(load_balancer, "vip_network_id")),
                "port_ids": related_ids(get_field(load_balancer, "vip_port_id")),
                "subnet_ids": related_ids(get_field(load_balancer, "vip_subnet_id")),
            },
        )

    # connect octavia child resources so a later policy can use cascade ordering.
    def load_balancer_child_record(self, resource_type: str, resource: object) -> InventoryRecord:
        relationships = {
            "load_balancer_ids": related_ids(
                get_field(resource, "loadbalancers", []), get_field(resource, "load_balancer_id")
            ),
            "pool_ids": related_ids(
                get_field(resource, "pools", []), get_field(resource, "pool_id"), get_field(resource, "default_pool_id")
            ),
        }
        return self.make_record(resource_type, resource, relationships=relationships)

    # collect pool's members because octavia requires the pool id list.
    def collect_pool_members(self, pool: object) -> None:
        pool_id = safe_identifier(get_field(pool, "id"))
        if not pool_id:
            self.record_error("load_balancer_member", "missing_pool_id")
            return
        try:
            for member in self.connection.load_balancer.members(pool):
                try:
                    self.add_record(
                        self.make_record(
                            "load_balancer_member",
                            member,
                            relationships={
                                "pool_ids": [pool_id],
                                "subnet_ids": related_ids(get_field(member, "subnet_id")),
                            },
                        )
                    )
                except (AttributeError, TypeError, ValueError) as exc:
                    self.record_error("load_balancer_member", exc, get_field(member, "id"))
        except OPENSTACK_EXCEPTIONS as exc:
            self.record_error("load_balancer_member", exc, pool_id)
        except (AttributeError, TypeError, ValueError) as exc:
            self.record_error("load_balancer_member", exc, pool_id)

    def collect_all(self) -> None:
        self.collect_servers()
        self.collect_list(
            "server_group", self.connection.compute.server_groups, lambda item: self.make_record("server_group", item)
        )
        self.collect_list("keypair", self.connection.compute.keypairs, self.keypair_record)

        self.collect_list("volume", lambda: self.connection.block_storage.volumes(details=True), self.volume_record)
        self.collect_list(
            "volume_snapshot",
            lambda: self.connection.block_storage.snapshots(details=True),
            lambda item: self.volume_child_record("volume_snapshot", item),
        )
        self.collect_list(
            "volume_backup",
            lambda: self.connection.block_storage.backups(details=True),
            lambda item: self.volume_child_record("volume_backup", item),
        )

        self.collect_list(
            "network",
            lambda: self.connection.network.networks(project_id=self.expected_project_id),
            lambda item: self.make_record("network", item),
        )
        self.collect_list(
            "subnet", lambda: self.connection.network.subnets(project_id=self.expected_project_id), self.subnet_record
        )
        self.collect_list(
            "router", lambda: self.connection.network.routers(project_id=self.expected_project_id), self.router_record
        )
        self.collect_list(
            "port", lambda: self.connection.network.ports(project_id=self.expected_project_id), self.port_record
        )
        self.collect_list(
            "security_group",
            lambda: self.connection.network.security_groups(project_id=self.expected_project_id),
            lambda item: self.make_record("security_group", item),
        )
        self.collect_list(
            "floating_ip",
            lambda: self.connection.network.ips(project_id=self.expected_project_id),
            self.floating_ip_record,
        )

        self.collect_list(
            "load_balancer",
            lambda: self.connection.load_balancer.load_balancers(project_id=self.expected_project_id),
            self.load_balancer_record,
        )
        self.collect_list(
            "load_balancer_listener",
            lambda: self.connection.load_balancer.listeners(project_id=self.expected_project_id),
            lambda item: self.load_balancer_child_record("load_balancer_listener", item),
        )
        pools = self.collect_list(
            "load_balancer_pool",
            lambda: self.connection.load_balancer.pools(project_id=self.expected_project_id),
            lambda item: self.load_balancer_child_record("load_balancer_pool", item),
        )
        self.collect_list(
            "load_balancer_health_monitor",
            lambda: self.connection.load_balancer.health_monitors(project_id=self.expected_project_id),
            lambda item: self.load_balancer_child_record("load_balancer_health_monitor", item),
        )
        for pool in pools:
            self.collect_pool_members(pool)

        self.records.sort(key=lambda item: (item.resource_type, item.resource_id))

    # keep the github view small while detailed safe records stay in artifacts.
    def summary_markdown(self, collected_at: str) -> str:
        counts = Counter(record.resource_type for record in self.records)
        lines = [
            "### OpenStack CI read-only inventory",
            "",
            f"- Project: `{self.project_name}` (`{self.project_id}`)",
            f"- Collected at: `{collected_at}`",
            f"- Resources: **{len(self.records)}**",
            f"- Collection errors: **{len(self.errors)}**",
            "",
            "#### Resource counts",
        ]
        lines.extend(f"- {resource_type}: {count}" for resource_type, count in sorted(counts.items()))
        if self.errors:
            lines.extend(["", "#### Collection errors"])
            lines.extend(f"- `{error.collection}`: `{error.error_code}`" for error in self.errors)
        return "\n".join(lines) + "\n"

    # save sanitized json and csv files with no raw sdk objects or metadata.
    def write_outputs(self, output_dir: Path, collected_at: str, source: Mapping[str, str] | None = None) -> None:
        output_dir.mkdir(parents=True, exist_ok=True, mode=stat.S_IRWXU)
        safe_source = {name: safe_text((source or {}).get(name)) for name in SOURCE_FIELDS}

        self._write_json(output_dir / "inventory.json", collected_at, safe_source)
        self._write_inventory_csv(output_dir / "inventory.csv", collected_at, safe_source)
        self._write_errors_csv(output_dir / "collection-errors.csv", collected_at, safe_source)
        self._write_summary_csv(output_dir / "summary.csv", collected_at, safe_source)

    def _write_json(self, output_path: Path, collected_at: str, source: Mapping[str, str]) -> None:
        payload = {
            "schema_version": INVENTORY_SCHEMA_VERSION,
            "collected_at": collected_at,
            "project": {"id": self.project_id, "name": self.project_name},
            "source": dict(source),
            "records": [asdict(record) for record in self.records],
            "collection_errors": [asdict(error) for error in self.errors],
        }
        output_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    def _write_inventory_csv(self, output_path: Path, collected_at: str, source: Mapping[str, str]) -> None:
        csv_fields = [
            "collected_at",
            *SOURCE_FIELDS,
            "resource_type",
            "resource_id",
            "name",
            "status",
            "secondary_status",
            "created_at",
            "updated_at",
            "project_id",
            "device_owner",
            "key_name",
            *RELATIONSHIP_TYPES,
        ]
        with output_path.open("w", encoding="utf-8", newline="") as inventory_file:
            writer = csv.DictWriter(inventory_file, fieldnames=csv_fields, quoting=csv.QUOTE_ALL)
            writer.writeheader()
            for record in self.records:
                row = asdict(record)
                relationships = row.pop("relationships")
                row.update({"collected_at": collected_at, **source})
                row.update({name: ";".join(relationships.get(name, [])) for name in RELATIONSHIP_TYPES})
                writer.writerow(row)

    def _write_errors_csv(self, output_path: Path, collected_at: str, source: Mapping[str, str]) -> None:
        with output_path.open("w", encoding="utf-8", newline="") as errors_file:
            writer = csv.writer(errors_file, quoting=csv.QUOTE_ALL)
            writer.writerow(("collected_at", *SOURCE_FIELDS, "collection", "resource_id", "error_code"))
            for error in self.errors:
                writer.writerow(
                    (
                        collected_at,
                        *(source[name] for name in SOURCE_FIELDS),
                        error.collection,
                        error.resource_id,
                        error.error_code,
                    )
                )

    def _write_summary_csv(self, output_path: Path, collected_at: str, source: Mapping[str, str]) -> None:
        summary_counts = Counter((record.resource_type, record.status or "unknown") for record in self.records)
        with output_path.open("w", encoding="utf-8", newline="") as summary_file:
            writer = csv.writer(summary_file, quoting=csv.QUOTE_ALL)
            writer.writerow(("collected_at", *SOURCE_FIELDS, "resource_type", "status", "count"))
            for (resource_type, status), count in sorted(summary_counts.items()):
                writer.writerow((collected_at, *(source[name] for name in SOURCE_FIELDS), resource_type, status, count))


# keep workflow and local options in the same parser.
def make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Collect a read-only inventory from the OpenStack CI project")
    parser.add_argument("--cloud", default=os.environ.get("OS_CLOUD"))
    parser.add_argument("--expected-project-id", required=True)
    parser.add_argument("--project-name", required=True)
    parser.add_argument("--output-dir", type=Path, default=Path("reports/ci-inventory"))
    return parser


# run collection with private output permissions and fail if any service was incomplete.
def main() -> ExitCode:
    os.umask(stat.S_IRWXG | stat.S_IRWXO)
    logging.basicConfig(level=logging.INFO, format="%(levelname)s: %(message)s", stream=sys.stdout)
    args = make_parser().parse_args()
    expected_project_id = safe_identifier(args.expected_project_id)
    project_name = safe_text(args.project_name)
    if not expected_project_id or not project_name:
        LOGGER.error("Inventory configuration has an unsafe project id or name")
        return ExitCode.FATAL_ERROR

    try:
        connection = openstack.connect(cloud=args.cloud, app_name="azimuth-ci-inventory", app_version="1")
        collector = InventoryCollector(
            connection,
            expected_project_id=expected_project_id,
            project_name=project_name,
        )
        collector.validate_project()
    except (ConfigurationError, exceptions.SDKException, ks_exceptions.ClientException) as exc:
        LOGGER.error("Inventory configuration failed (%s)", error_code(exc))
        return ExitCode.FATAL_ERROR

    collected_at = datetime.now(timezone.utc).isoformat(timespec="seconds")
    source = source_context()
    try:
        collector.collect_all()
        collector.write_outputs(args.output_dir, collected_at, source)
    except Exception as exc:  # noqa: BLE001 - final safety boundary for CI
        collector.record_error("inventory", exc)
        try:
            collector.write_outputs(args.output_dir, collected_at, source)
        except OSError:
            LOGGER.error("Could not write inventory artifacts")
            return ExitCode.FATAL_ERROR

    summary = collector.summary_markdown(collected_at)
    LOGGER.info("\n%s", summary.rstrip())
    append_step_summary(summary)
    if collector.errors:
        return ExitCode.PARTIAL_INVENTORY
    return ExitCode.SUCCESS


if __name__ == "__main__":
    sys.exit(main())
